<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield Outer Outline -->
    <path
        android:pathData="M54,20 L80,30 C80,60 54,84 54,84 C54,84 28,60 28,30 Z"
        android:strokeWidth="3.5"
        android:strokeColor="#00F0FF"
        android:fillColor="#102540" />

    <!-- Inner Shield Accent -->
    <path
        android:pathData="M54,27 L73,34 C73,57 54,75 54,75 C54,75 35,57 35,34 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="35"
                android:startY="27"
                android:endX="73"
                android:endY="75"
                android:type="linear">
                <item android:offset="0.0" android:color="#00F0FF" />
                <item android:offset="1.0" android:color="#00E676" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Checkmark Emblem inside Shield -->
    <path
        android:pathData="M46,51 L51,56 L62,45"
        android:strokeWidth="4"
        android:strokeColor="#0A0F1D"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
