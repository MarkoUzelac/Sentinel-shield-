# OpenCellID API Key for Backend Cell-Tower Enrichment & Lookup (Server-Side Secret)
OPENCELLID_API_KEY=

# Geoapify API Key (for Geocoding, Reverse Geocoding, and Location Search)
VITE_GEOAPIFY_API_KEY=

# Gemini API key for AI Threat Analysis & Sentinel Chat Advisor
GEMINI_API_KEY=

# Geo Map Style URL (Optional, defaults to OpenFreeMap vector dark tiles)
VITE_MAP_STYLE_URL=

# Geocoding Endpoint (Optional - defaults to Geoapify with OpenStreetMap fallback)
VITE_GEOCODING_API_URL=

