# GEMINI_API_KEY: Optional. Required for Gemini AI API calls.
# AI Studio injects this from user secrets when configured.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# HIBP_API_KEY: Optional. Required for Have I Been Pwned account breach lookups.
# Never commit a real API key. Configure it through the AI Studio / CI secret store.
# HIBP_API_KEY=MY_HIBP_API_KEY

# OPEN_CELL_ID_API_KEY: Optional. Enables real cell-tower geolocation from OpenCellID.
# Never commit the real key. Configure it through the AI Studio / CI secret store.
# OPEN_CELL_ID_API_KEY=MY_OPEN_CELL_ID_API_KEY
